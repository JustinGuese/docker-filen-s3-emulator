# Local dev overrides (APP_ENV=local). Committed, non-secret.
# Never fed to the cluster.
# A local `filen s3` gateway, started with the same key pair as this service (see
# README "Local development") -- mirrors the sidecar in the Helm chart.
FILEN_ENDPOINT=http://127.0.0.1:8080
STAGING_DIR=./.staging
