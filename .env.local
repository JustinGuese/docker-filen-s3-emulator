# Local dev overrides (APP_ENV=local). Committed, non-secret.
# Never fed to the cluster.
# A laptop can't reach the in-cluster gateway Service directly, so this points at its
# externally-exposed hostname instead -- same underlying Filen account as k8s/filen-cli.yaml.
FILEN_ENDPOINT=https://filen-s3.datafortress.cloud
STAGING_DIR=./.staging
