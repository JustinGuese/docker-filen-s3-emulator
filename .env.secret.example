# Template for .env.secret. Key names only -- never real values.
# Whole-line comments only: kubectl keeps a trailing "# ..." as part of the
# value fed to --from-env-file.
# The key pair clients of this service sign with.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The Filen gateway's own S3 credentials (its --s3-access-key-id / --s3-secret-access-key).
FILEN_ACCESS_KEY=
FILEN_SECRET_KEY=
# The Filen account this deployment's own `filen s3` gateway (k8s/filen-cli.yaml) logs
# into. Use a dedicated account if you don't want the cluster holding your main password.
FILEN_EMAIL=
FILEN_PASSWORD=
