# Template for .env.secret. Key names only -- never real values.
# Whole-line comments only: kubectl keeps a trailing "# ..." as part of the
# value fed to --from-env-file.
# The one key pair: clients of this service sign with it, and the Filen gateway
# (`filen s3`) is started with it, so this service reuses it upstream.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The Filen account the gateway logs into. Use a dedicated account if you don't
# want the cluster holding your main password.
FILEN_EMAIL=
FILEN_PASSWORD=
