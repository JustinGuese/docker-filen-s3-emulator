# Public defaults, committed, read before everything else.
APP_NAME=filen-s3-emulator
LOG_LEVEL=INFO
FILEN_REGION=filen
# The gateway buffers a whole PUT in memory; completed multipart uploads are capped here.
MAX_OBJECT_BYTES=1073741824
STAGING_DIR=/staging
MULTIPART_EXPIRY_HOURS=24
LIST_CACHE_SECONDS=15
